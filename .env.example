# ============================================================
# Khata — environment variables
# Copy to .env for local dev; set in Vercel → Settings → Env Vars for production.
# ============================================================

# --- Database: Turso (REQUIRED in production) ---
# 1. Create a free database at https://turso.tech
# 2. Copy the "Database URL"  → DATABASE_URL
# 3. Create a token            → DATABASE_AUTH_TOKEN
# Run the KHATA_DB_SETUP.ipynb Colab notebook (in the repo root) to push the
# schema + defaults to your Turso DB in one click.
DATABASE_URL="libsql://your-db-your-user.turso.io"
DATABASE_AUTH_TOKEN="eyJ..."
# Local dev fallback (SQLite file, no token needed):
# DATABASE_URL="file:./db/khata.db"

# --- Admin panel auth (/admin) — REQUIRED ---
ADMIN_USERNAME="admin"
# Plain text OR a bcrypt hash ($2b$...) — preferred. Generate: bun run hash-password <pw>
ADMIN_PASSWORD="change-me-strong"

# --- Public app URL (SEO metadata, sitemap, QStash callback URLs) ---
# Scheme optional since V1.1: "khata.namansoni.in" is auto-normalized to
# https://khata.namansoni.in (this fixed the QStash "invalid destination
# scheme" 400 that silently killed scheduled notifications).
NEXT_PUBLIC_APP_URL="https://khata.namansoni.in"

# --- Email / OTP (REQUIRED for signup + password reset) ---
# Resend (free tier: 100 mails/day): https://resend.com
# Verify the khata.namansoni.in domain in Resend (DNS records) so you can
# send from no-reply@khata.namansoni.in.
RESEND_API_KEY="re_..."
RESEND_FROM="Khata <no-reply@khata.namansoni.in>"
# Dev-only: when no RESEND_API_KEY is set, OTP codes are returned in API
# responses instead of being emailed. NEVER enable in production.
# EMAIL_DEV_MODE="true"

# --- Web Push (VAPID) — generate with: bun run gen-vapid ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Upstash QStash (scheduled reminders + exact-time delivery) ---
# MULTIPLE ACCOUNTS supported to multiply the free quota — separate with ";" :
#   QSTASH_TOKEN="tokenA;tokenB;tokenC"
#   QSTASH_CURRENT_SIGNING_KEY="curKeyA;curKeyB;curKeyC"
#   QSTASH_NEXT_SIGNING_KEY="nextKeyA;nextKeyB;nextKeyC"
# Recurring reminder schedules are spread across accounts automatically.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
