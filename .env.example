# ============================================================
# Khata — environment variables
# Copy to .env for local dev; set in Vercel → Settings → Env Vars for production.
# ============================================================

# --- Database (REQUIRED in production) ---
# Neon Postgres (recommended, free tier): https://neon.tech
# Use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Admin panel auth (/admin) — REQUIRED ---
ADMIN_USERNAME="admin"
# Plain text OR a bcrypt hash ($2b$...) — preferred. Generate: bun run hash-password <pw>
ADMIN_PASSWORD="admin123"

# --- Public app URL (SEO metadata, sitemap, QStash callback URLs) ---
NEXT_PUBLIC_APP_URL="https://khata.namansoni.in"

# --- WebAuthn Relying Party (set to your domain in production) ---
NEXT_PUBLIC_RP_ID="khata.namansoni.in"

# --- Web Push (VAPID) — generate with: bun run gen-vapid ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Upstash QStash (scheduled reminders + exact-time delivery) ---
# Token + signing keys from https://console.upstash.com/qstash
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
