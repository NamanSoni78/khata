// Khata — Finance Tracker PWA
// Database: Turso (libSQL) in production, local SQLite file in dev.
// Prisma + @prisma/adapter-libsql driver adapter (see src/lib/db.ts).
//
// Production (Turso):
//   DATABASE_URL="libsql://your-db.turso.io"
//   DATABASE_AUTH_TOKEN="eyJ..."
//   -> schema is pushed via the Colab notebook (KHATA_DB_SETUP.ipynb) or
//      `bun run turso:setup` (scripts/turso-setup.ts).
//
// Local dev (sandbox / localhost):
//   DATABASE_URL="file:/path/to/dev.db"
//   -> `bun run db:push`.
//
// All JSON-ish columns use String + JSON.stringify/parse (SQLite-friendly),
// and every major entity carries a `metadata` column — the agent can attach
// arbitrary custom fields at runtime (liquid schema).
generator client {
  provider        = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
// ============================================================
//  CORE: USERS & AUTH (Gmail + password + OTP + MPIN)
// ============================================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique // plain gmail address, e.g. "rahul@gmail.com" (no dots / +tags)
  username      String   @unique // display name (defaults to email local-part, editable)
  passwordHash  String
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true) // false only for soft-disabled accounts
  prefs         String   @default("{}") // JSON: per-user UI preferences (wallpaper, voice language…)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mpin                   UserMpin?
  otpCodes               OtpCode[]
  userConfigs            UserConfig[]
  sessions               UserSession[]
  accounts               Account[]
  contacts               Contact[]
  categories             Category[]
  tags                   Tag[]
  transactions           Transaction[]
  transactionGroups      TransactionGroup[]
  pendingQuestions       PendingQuestion[]
  chatMessages           ChatMessage[]
  pushSubscriptions      PushSubscription[]
  scheduledNotifications ScheduledNotification[]
  mindmaps               Mindmap[]
  @@index([username])
}
/// One row per user — MPIN hashes + brute-force lockout state.
/// appMpinHash: 4-digit code that unlocks the daily PWA (required).
/// dashboardMpinHash: 6-digit code that unlocks /dashboard (optional —
/// dashboard falls back to email+password when null).
model UserMpin {
  id                 String    @id @default(cuid())
  userId             String    @unique
  appMpinHash        String
  dashboardMpinHash  String?
  appFailedAttempts  Int       @default(0)
  dashFailedAttempts Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
/// OTP codes for signup verification + password reset.
/// purpose: "signup" | "forgot"
model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  purpose   String // "signup" | "forgot"
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0) // wrong-entry counter (max 5)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, createdAt])
}
model UserSession {
  id              String   @id @default(cuid())
  userId          String
  type            String // 'daily' | 'dashboard' | 'admin'
  token           String   @unique
  expiresAt       DateTime
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type])
  @@index([token])
}
/// Per-user AI configuration (own API keys / base URLs / models overriding
/// the admin defaults). `key` is e.g. "ai.daily", "ai.dashboard", "ai.stt",
/// "ai.vision", "ai.instructions". value is JSON — shape depends on key.
model UserConfig {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
}
// ============================================================
//  FINANCIAL ENTITIES — all have `metadata` String(JSON) for liquid schema
// ============================================================
model Account {
  id          String   @id @default(cuid())
  userId      String
  name        String // e.g. "SBI Savings", "Angle One Demat", "Cash Wallet"
  type        String // 'bank' | 'demat' | 'wallet' | 'cash' | 'investment' | 'other'
  institution String?
  balance     Float    @default(0)
  currency    String   @default("INR")
  metadata    String   @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  txnsFrom Transaction[] @relation("TxnFromAccount")
  txnsTo   Transaction[] @relation("TxnToAccount")
  @@index([userId, type])
  @@index([userId, isActive])
}
model Contact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String // 'friend' | 'family' | 'colleague' | 'merchant' | 'other'
  relationship String?
  balance      Float    @default(0) // +ve = they owe me, -ve = I owe them
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("TxnContact")
  @@index([userId])
}
model Category {
  id        String    @id @default(cuid())
  userId    String
  name      String
  type      String // 'expense' | 'income' | 'transfer' | 'investment' | 'loan'
  parentId  String?
  icon      String?
  metadata  String    @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryParent")
  transactions Transaction[]
  @@index([userId, type])
}
model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]
  @@unique([userId, name])
}
model TransactionTag {
  transactionId String
  tagId         String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([transactionId, tagId])
}
model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String // 'expense' | 'income' | 'transfer' | 'investment' | 'loan_out' | 'loan_in' | 'profit' | 'loss' | 'fee'
  amount        Float
  fromAccountId String?
  toAccountId   String?
  contactId     String?
  categoryId    String?
  groupId       String?
  timestamp     DateTime @default(now())
  notes         String?
  metadata      String   @default("{}")
  source        String   @default("manual") // 'chat' | 'statement' | 'admin' | 'agent_inferred'
  status        String   @default("confirmed") // 'pending' | 'confirmed' | 'rejected'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account?           @relation("TxnFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccount   Account?           @relation("TxnToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  contact     Contact?           @relation("TxnContact", fields: [contactId], references: [id], onDelete: SetNull)
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  group       TransactionGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tags        TransactionTag[]
  @@index([userId, timestamp])
  @@index([userId, type])
  @@index([groupId])
  @@index([userId, status])
}
model TransactionGroup {
  id          String   @id @default(cuid())
  userId      String
  label       String
  description String?
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  transactions Transaction[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model PendingQuestion {
  id         String    @id @default(cuid())
  userId     String
  question   String
  context    String    @default("{}")
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
}
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // 'user' | 'assistant' | 'system' | 'tool'
  content   String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  keys      String // JSON: { p256dh, auth }
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model ScheduledNotification {
  id          String    @id @default(cuid())
  userId      String
  type        String    @default("daily") // 'once' | 'daily' | 'weekly' | 'monthly'
  time        String    @default("20:00") // HH:MM 24h IST
  date        String? // YYYY-MM-DD (once only)
  daysOfWeek  String    @default("[]") // JSON array of 0-6 (weekly)
  dayOfMonth  Int?
  timezone    String    @default("Asia/Kolkata")
  nextRunAt   DateTime?
  schedule    String    @default("") // legacy cron/ISO (old rows)
  title       String    @default("Khata")
  message     String
  template    String?
  lastFiredAt DateTime?
  isActive    Boolean   @default(true)
  // QStash multi-account support: which pooled QStash account owns this
  // reminder's schedule (index into the ";"-separated QSTASH_TOKEN env list).
  qstashScheduleId  String?
  qstashAccount     Int?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isActive])
  @@index([isActive, nextRunAt])
}
// ============================================================
//  MINDMAPS — user-saved React Flow diagrams
// ============================================================
model Mindmap {
  id          String   @id @default(cuid())
  userId      String
  name        String
  nodes       String   @default("[]")
  edges       String   @default("[]")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, updatedAt])
}
// ============================================================
//  ADMIN CONFIG — flexible key/value store for admin-set values
// ============================================================
model AdminConfig {
  key       String   @id
  value     String // JSON string
  updatedAt DateTime @updatedAt
}
